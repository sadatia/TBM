<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PTJV | Analytics Engine</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @media print { 
            .no-print { display: none !important; } 
            body { background: white; } 
            .print-card { border: 1px solid #e2e8f0; box-shadow: none; } 
        }
    </style>
</head>
<body class="bg-slate-100 font-sans flex flex-col md:flex-row min-h-screen">
    
    <!-- Sidebar Navigation -->
    <aside class="no-print bg-[#002b5c] w-full md:w-64 p-6 text-white flex flex-col justify-between shrink-0">
        <div>
            <div class="flex items-center gap-3 mb-8 bg-white/10 p-3 rounded-xl border border-white/20">
                <img src="/logo/ptjvlogo.png" alt="PTJV Logo" class="h-8 bg-white p-1 rounded">
                <div>
                    <h2 class="font-bold text-xs tracking-wider uppercase">Penta-Ocean / TOA</h2>
                    <p class="text-[10px] text-blue-200">Analytics Engine</p>
                </div>
            </div>

            <nav class="space-y-2">
                <a href="/admin/dashboard" class="flex items-center p-3 text-slate-300 hover:bg-white/10 rounded-xl transition">
                    <i class="fas fa-home w-6"></i> Dashboard
                </a>
                <a href="/admin/analytics" class="flex items-center p-3 bg-white/10 rounded-xl font-bold border-l-4 border-yellow-500 text-white">
                    <i class="fas fa-chart-pie w-6"></i> Analytics & Reports
                </a>
                <a href="/" class="flex items-center p-3 text-slate-300 hover:bg-white/10 rounded-xl transition">
                    <i class="fas fa-external-link-alt w-6"></i> Public Kiosk
                </a>
                <a href="/admin/download-pdf" class="flex items-center p-3 text-slate-300 hover:bg-white/10 rounded-xl transition">
    <i class="fas fa-file-pdf w-6"></i> Export PDF Report
</a>
            </nav>
        </div>

        <div class="pt-6 border-t border-white/10">
            <a href="/admin/logout" class="flex items-center p-3 text-red-300 hover:bg-red-500/20 rounded-xl font-bold transition">
                <i class="fas fa-sign-out-alt w-6"></i> Sign Out
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 md:p-10">
        <!-- Date Selector Card -->
        <div class="no-print bg-white p-8 rounded-[2rem] shadow-sm mb-10 border border-slate-100">
            <h2 class="text-2xl font-black mb-6 text-slate-800">Select Date Range</h2>
            <form action="/admin/analytics" method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-2">Start Date</label>
                    <input type="date" name="startDate" value="<%= startDate || '' %>" required class="w-full mt-1 bg-slate-50 border rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 transition">
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-2">End Date</label>
                    <input type="date" name="endDate" value="<%= endDate || '' %>" required class="w-full mt-1 bg-slate-50 border rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 transition">
                </div>
                <button class="bg-[#002b5c] text-white py-4 rounded-2xl font-bold shadow-lg hover:scale-[1.01] active:scale-95 transition">
                    Run Analysis
                </button>
            </form>
        </div>

        <% if (startDate && endDate) { %>
            <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
                <div>
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight">Personnel Health Report</h1>
                    <p class="text-slate-400 font-medium">Spanning from <span class="text-blue-600 underline font-bold"><%= startDate %></span> to <span class="text-blue-600 underline font-bold"><%= endDate %></span></p>
                </div>
                <button onclick="window.print()" class="no-print bg-yellow-500 text-slate-900 px-6 py-3 rounded-2xl font-bold text-sm shadow-lg hover:bg-yellow-400 transition">
                    <i class="fas fa-print mr-2"></i> Print Report
                </button>
            </div>

            <!-- Metrics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
                <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 print-card">
                    <p class="text-[10px] font-black text-slate-400 uppercase mb-2">Total Logs</p>
                    <p class="text-4xl font-black text-slate-800"><%= overallStats.totalLogs %></p>
                </div>
                <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 print-card">
                    <p class="text-[10px] font-black text-green-500 uppercase mb-2">Healthy Status</p>
                    <p class="text-4xl font-black text-green-600"><%= overallStats.well %></p>
                </div>
                <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 print-card">
                    <p class="text-[10px] font-black text-red-500 uppercase mb-2">Medical Issues</p>
                    <p class="text-4xl font-black text-red-600"><%= overallStats.notWell %></p>
                </div>
                <div class="bg-[#002b5c] p-6 rounded-[2rem] shadow-xl text-white">
                    <p class="text-[10px] font-black text-blue-200 uppercase mb-2">Average Compliance</p>
                    <p class="text-4xl font-black">
                        <%= reportData.length > 0 ? Math.round(reportData.reduce((acc, curr) => acc + curr.complianceScore, 0) / reportData.length) : 0 %>%
                    </p>
                </div>
            </div>

            <!-- Breakdown Table -->
            <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden mb-10">
                <div class="p-6 border-b border-slate-100 font-bold italic text-slate-800">
                    Personnel Compliance Breakdown
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                            <tr>
                                <th class="p-6">Employee</th>
                                <th class="p-6">Submissions</th>
                                <th class="p-6">Health Quality</th>
                                <th class="p-6">Compliance Score</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% reportData.forEach(user => { %>
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-6">
                                        <p class="font-black text-slate-800"><%= user.name %></p>
                                        <p class="text-[10px] font-bold text-slate-400 uppercase"><%= user.position %></p>
                                    </td>
                                    <td class="p-6">
                                        <span class="text-xl font-bold text-slate-700"><%= user.submissionCount %></span>
                                        <span class="text-slate-400 text-xs">logs</span>
                                    </td>
                                    <td class="p-6">
                                        <div class="flex items-center gap-4">
                                            <span class="text-xs font-bold text-green-600"><%= user.wellCount %> Well</span>
                                            <div class="h-2 w-20 bg-slate-100 rounded-full overflow-hidden flex">
                                                <div class="bg-green-500 h-full" style="width: <%= user.submissionCount > 0 ? (user.wellCount / user.submissionCount) * 100 : 0 %>%"></div>
                                                <div class="bg-red-500 h-full" style="width: <%= user.submissionCount > 0 ? (user.notWellCount / user.submissionCount) * 100 : 0 %>%"></div>
                                            </div>
                                            <span class="text-xs font-bold text-red-500"><%= user.notWellCount %> Not Well</span>
                                        </div>
                                    </td>
                                    <td class="p-6">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-1 bg-slate-100 h-3 rounded-full overflow-hidden">
                                                <div class="bg-blue-600 h-full rounded-full" style="width: <%= user.complianceScore %>%"></div>
                                            </div>
                                            <span class="font-black text-slate-800 w-10"><%= user.complianceScore %>%</span>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-32 opacity-30">
                <i class="fas fa-calendar-alt text-7xl mb-4"></i>
                <p class="text-xl font-black uppercase tracking-wider">Select a date range to generate analysis</p>
            </div>
        <% } %>
    </main>

</body>
</html>